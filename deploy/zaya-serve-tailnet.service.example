# Variante para expor no tailnet (SSH + clientes de fora de casa).
# Instale com `zmin serve install --tailnet` (ele confere o IP do tailnet e
# exige ZAYA_SERVE_TOKEN no ~/.config/zaya/.env).
# Ajustar à mão só se o IP do mini mudar: `tailscale ip -4`.
[Unit]
Description=Zaya (motor + API/SSE no tailnet)
# Unidade de USUARIO: nao pode Requires=tailscaled.service (unidade de
# sistema). O host sobe o tailscale no boot; se o IP ainda nao existir no
# bind, o Restart=always tenta de novo.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/zaya
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/zaya/.env
Environment=ZAYA_SERVE_ALLOW_REMOTE=true
ExecStart=%h/zaya/.venv/bin/zaya serve --host 100.66.45.57
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
