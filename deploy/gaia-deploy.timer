[Unit]
Description=Atualiza a Gaia do mini a cada 5 minutos (git, nao rsync)

[Timer]
OnBootSec=3min
# 5 min e nao 1 min: codigo novo so vale depois do restart, e cada restart
# custa ~13 s de SIGTERM (worker de memoria, AGENTS.md "armadilhas"). Cinco
# minutos deixam de 5 em 5 minutos o app fora do ar por 13 s em vez de num
# minuto de cada vez; sem commit novo o script sai 0 sem reiniciar nada.
OnUnitActiveSec=5min
AccuracySec=30s
# Sem Persistent=true: mini desligado nao deve disparar uma rajada atrasada —
# a proxima rodada ja pega o HEAD de origin/main.
Persistent=false

[Install]
WantedBy=timers.target
